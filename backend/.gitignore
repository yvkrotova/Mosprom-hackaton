# Секреты
.env

# Данные: БД, загруженные видео, доказательства, тестовые ролики, рендеры и кэш детекций.
# В git — только описание тестовых роликов (манифест, черновик разметки, инвентаризация).
data/*
!data/videos/
data/videos/*
!data/videos/manifest.json
!data/videos/labels.json
!data/videos/inventory.json

# Тяжёлые тестовые файлы генерируются скриптом
tests/fixtures/*.mp4

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Веса моделей не коммитятся (как получить — README, «Модель YOLOv8s»)
models/*.onnx
models/*.pt
