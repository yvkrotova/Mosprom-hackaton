# Скопируйте в .env и заполните. Файл .env не коммитится (он в .gitignore).
# Логины, пароли и токены — ТОЛЬКО в .env, никогда в коде и в репозитории.

# База данных. SQLite по умолчанию; для PostgreSQL: postgresql+psycopg://user:pass@host:5432/db
DATABASE_URL=sqlite:///./data/app.db
# Постоянный каталог для загруженных видео и кадров-доказательств (не /tmp)
STORAGE_DIR=./data/storage
# Применять миграции Alembic при старте backend
AUTO_MIGRATE=true

# Токен внутреннего API воркер -> backend (заголовок X-Internal-Token).
# Пусто: backend сгенерирует случайный при старте (подходит, если воркеры запускает сам backend).
# Для ручного запуска воркера задайте одинаковое значение для backend и воркера.
INTERNAL_TOKEN=
# Адрес backend, по которому к нему обращается воркер
BACKEND_URL=http://localhost:8000
# Разрешённые адреса фронтенда, через запятую
CORS_ORIGINS=http://localhost:5173

# Детектор: mock (заглушка) | replay (детекции из JSONL-файла)
#         | onnx (YOLOv8s на CPU этого компьютера — НЕ LinQ) | linq (модель на ускорителе LinQ)
DETECTOR=mock
# Путь к JSONL-файлу детекций для DETECTOR=replay (формат — docs/CV_CONTRACT.md)
REPLAY_PATH=

# Модель YOLOv8 для DETECTOR=onnx и linq. Файл не коммитится — см. README, «Модель YOLOv8s»
MODEL_PATH=./models/yolov8s.onnx
# Сторона квадратного входа сети, пиксели (берётся из модели, если там задан)
MODEL_INPUT_SIZE=640
# Порог уверенности детекции (низкий: слабые детекции нужны ByteTrack; правила отсекают их своим
# min_confidence) и порог IoU для NMS. Старое имя CONF_THRESHOLD тоже читается.
DETECTOR_CONF_THRESHOLD=0.1
IOU_THRESHOLD=0.45
# Какие классы COCO оставлять, через запятую (person, car, motorcycle, bus, truck, ...)
DETECT_CLASSES=person
# Сцена заглушки DETECTOR=mock: danger_zone (вход в зону) | run_fast_movement (ходьба, бег, помехи)
MOCK_SCENARIO=danger_zone

# Трекер: bytetrack (по умолчанию) | iou (прежний, для сравнения)
TRACKER=bytetrack
# Уверенные детекции (первый этап и новые треки) / слабые (второй этап, продлевают трек)
TRACK_HIGH_THRESH=0.5
TRACK_LOW_THRESH=0.1
# Максимальная «стоимость» 1 − IoU·уверенность при сопоставлении
TRACK_MATCH_THRESH=0.8
# Сколько секунд видео держать пропавший трек (не меньше gap_tolerance_s правил)
TRACK_BUFFER_S=2.0
# Попаданий до подтверждения трека (в правила идут только подтверждённые)
TRACK_MIN_HITS=3
# Не чаще стольких снимков треков в секунду для живого просмотра (0 — без ограничения)
TRACKS_PUSH_HZ=8
# true — видеофайл анализируется в темпе реального времени (тревоги приходят «вживую», для демо);
# false — как можно быстрее (для замеров FPS)
REALTIME_PLAYBACK=false
# true — после загрузки видео анализ запускается сам (правило бега создаётся автоматически)
AUTO_START_ON_UPLOAD=true
# Как часто воркер перечитывает зоны и правила; изменения у запущенного источника применяются на лету, с
CONFIG_RELOAD_S=2
# Анализ сцены (сценарий «Заблокированный проход»): обновлений в секунду и сколько секунд собирать
# автоматический эталон, если «пустой проход» не сохранён
SCENE_ANALYSIS_HZ=4
SCENE_BOOTSTRAP_S=3

# Как часто воркер шлёт heartbeat, с
HEARTBEAT_INTERVAL_S=2
# Нет heartbeat дольше этого — источник помечается disconnected, с
HEARTBEAT_TIMEOUT_S=10
# Не чаще этого отправлять обновления активного эпизода, с
EPISODE_UPDATE_INTERVAL_S=1
# Частота анализа кадров по умолчанию для новых источников, кадр/с
DEFAULT_ANALYSIS_FPS=10
# Максимальный размер загружаемого видео, МБ
MAX_UPLOAD_MB=2048

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Ускоритель LinQ (значения выдают организаторы; не коммитить!)
LINQ_API_URL=
LINQ_LOGIN=
LINQ_PASSWORD=
LINQ_PROGRAM=
